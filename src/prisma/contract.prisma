// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  body   String?
  author    User?     @relation(fields: [authorId], references: [id])
  authorId  Int?
  votes   Int    @default(0)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
